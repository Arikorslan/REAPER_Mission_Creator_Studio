static func icon(name: String, color := Color("dfe4ea")) -> Texture2D:
	var key := name + "|" + color.to_html(false)
	if _cache.has(key): return _cache[key]
	var image := Image.create(SIZE, SIZE, false, Image.FORMAT_RGBA8)
	image.fill(Color(0, 0, 0, 0))
	_image = image
	if OPS.has(name):
		for op in OPS[name]: _paint_op(op, color)
	else:
		for y in range(4, 16): _pixel(10, y, color)
	var texture := ImageTexture.create_from_image(image)
	_cache[key] = texture
	return texture

static func _paint_op(op: Array, color: Color) -> void:
	var kind := str(op[0])
	if kind == "r":
		for yy in range(int(op[2]), int(op[2]) +int(op[4])):
			for xx in range(int(op[1]), int(op[1]) +int(op[3])): _pixel(xx, yy, color)
	elif kind == "b":
		var x := int(op[1]); var y := int(op[2]); var w := int(op[3]); var h := int(op[4])
		for xx in range(x, x + w):
			_pixel(xx, y, color); _pixel(xx, y + h - 1, color)
			_pixel(xx, y + 1, color); _pixel(xx, y + h - 2, color)
		for yy in range(y, y + h):
			_pixel(x, yy, color); _pixel(x + w - 1, yy, color)
			_pixel(x + 1, yy, color); _pixel(x + w - 2, yy, color)
	elif kind == "l":
		_line(int(op[1]), int(op[2]), int(op[3]), int(op[4]), int(op[5]) if op.size() > 5 else 1, color)
	elif kind == "d":
		_dash(int(op[1]), int(op[2]), int(op[3]), int(op[4]), int(op[5]) if op.size() > 5 else 1, color)
	elif kind == "c":
		var r := int(op[3])
		for yy in range(int(op[2]) -r, int(op[2]) +r + 1):
			for xx in range(int(op[1]) -r, int(op[1]) +r + 1):
				if Vector2(xx - int(op[1]), yy - int(op[2])).length() <= float(r): _pixel(xx, yy, color)
	elif kind == "o":
		var radius := int(op[3])
		for deg in range(0, 361, 3):
			var rad := deg * PI / 180.0
			_pixel(int(op[1]) +int(round(cos(rad) * radius)), int(op[2]) +int(round(sin(rad) * radius)), color)

static func _pixel(x: int, y: int, color: Color) -> void:
	if _image == null or x < 0 or y < 0 or x >= SIZE or y >= SIZE: return
	_image.set_pixel(x, y, color)

static func _line(x0: int, y0: int, x1: int, y1: int, thickness: int, color: Color) -> void:
	var steps := maxi(absi(x1 - x0), absi(y1 - y0))
	if steps == 0: _pixel(x0, y0, color); return
	for step in range(steps + 1):
		var t := float(step) / float(steps)
		var x := int(round(lerpf(x0, x1, t))); var y := int(round(lerpf(y0, y1, t)))
		var lo := -int(thickness / 2)
		for oy in range(lo, lo + thickness):
			for ox in range(lo, lo + thickness): _pixel(x + ox, y + oy, color)

static func _dash(x0: int, y0: int, x1: int, y1: int, thickness: int, color: Color) -> void:
	var steps := maxi(absi(x1 - x0), absi(y1 - y0))
	if steps == 0: _pixel(x0, y0, color); return
	for step in range(steps + 1):
		var t := float(step) / float(steps)
		var x := int(round(lerpf(x0, x1, t))); var y := int(round(lerpf(y0, y1, t)))
		for oy in range(0, thickness):
			for ox in range(0, thickness): _pixel(x + ox, y + oy, color)
